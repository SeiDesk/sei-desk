+        drop(locked);
+        std::fs::rename(temp.0.join("Duplicate.lnk"), temp.0.join("Renamed.lnk")).unwrap();
+        let renamed = discover(
+            &roots,
+            &mut reader,
+            Limits::default(),
+            &Cancellation::default(),
+            None,

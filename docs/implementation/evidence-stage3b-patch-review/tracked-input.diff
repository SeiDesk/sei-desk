+                .issues
+                .iter()
+                .find(|i| i.path.file_name().unwrap() == "Stale.lnk")
+                .unwrap()
+                .error
+                .kind,
+            ErrorKind::Missing
+        );
+        let second = discover(
+            &roots,
+            &mut reader,
+            Limits::default(),
+            &Cancellation::default(),
+            None,
+        )
+        .unwrap();
